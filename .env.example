# Domínios que poderão servir a aplicação, sem https:// e sem porta.
CERTIFICA_ALLOWED_HOSTS=certidoes.seudominio.com,localhost,127.0.0.1

# Recomendado sempre que a aplicação for publicada na internet.
CERTIFICA_BASIC_USER=cliente
CERTIFICA_BASIC_PASSWORD=troque-por-uma-senha-longa

# Quantidade máxima de consultas aguardando o único worker.
CERTIFICA_MAX_QUEUE=100

# Porta publicada pelo Docker Compose.
PORT=8000
